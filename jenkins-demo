pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: 'b1']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/paridhikhare27/jenkins-demo.git']]])
            }
        }
        stage('Build') {
            steps {
                git branch: 'b1', url: 'https://github.com/paridhikhare27/jenkins-demo.git'
                bat 'python hello.py'
            }
        }
        stage('Test') {
            steps {
                echo 'TESTING'
            }
        }
         stage('Docker Deploy') {
            steps {
                echo 'Building Docker image...'
                // Build Docker image (tag as 'myapp:latest')
                bat 'docker build -t myapp:latest .'

                echo 'Running Docker container...'
                // Run Docker container on port 5000
                bat 'docker run -d --name myapp_container11 myapp:latest'

                echo 'Docker deployment completed!'
            }
        }
    }
}
